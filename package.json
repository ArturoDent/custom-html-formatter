{
  "name": "custom-html-formatter",
  "displayName": "Custom HTML Formatter",
  "description": "Use custom rules to format html",
  "publisher": "ArturoDent",
  "repository": {
    "type": "git",
    "url": "https://github.com/ArturoDent/custom-html-formatter"
  },
  "license": "MIT",
  "version": "0.3.0",
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Formatters"
  ],
  "activationEvents": [
    "onLanguage:html"
  ],
  "main": "./out/src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "customHtmlFormatter.enableAllWithDefaults",
        "title": "Enable both js-beautify and Custom HTML Formatter and rules",
        "category": "Custom HTML Formatter"
      },
      {
        "command": "customHtmlFormatter.enableJsBeautifyOnly",
        "title": "Enable js-beautify and disable the Custom HTML Formatter",
        "category": "Custom HTML Formatter"
      },
      {
        "command": "customHtmlFormatter.restoreBuiltinHtmlFormatter",
        "title": "Revert to default html formatter (disable js-beautify and the CustomHTML Formatter)",
        "category": "Custom HTML Formatter"
      },
      {
        "command": "customHtmlFormatter.dryRun",
        "title": "Dry-run preview changes",
        "category": "Custom HTML Formatter"
      },
      {
        "command": "customHtmlFormatter.showHealth",
        "title": "Show Health",
        "category": "Custom HTML Formatter"
      }
    ],
    "configuration": {
      "title": "Custom HTML Formatter",
      "properties": {
        "customHtmlFormatter.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable the Custom HTML Formatter - will run after js-beautify (if enabled) which formats html files."
        },
        "customHtmlFormatter.jsBeautifyEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable js-beautify - will run instead of the built-in html formatter."
        },
        "customHtmlFormatter.rules": {
          "type": "object",
          "default": {},
          "description": "Selector-based indentation rules for the Custom HTML Formatter",
          "properties": {
            "noIndentUnder": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9-]*$"
              },
              "description": "HTML tag names whose direct children should not be indented"
            },
            "indentSize": {
              "type": "number",
              "minimum": 0,
              "description": "Number of spaces per indentation level"
            }
          },
          "additionalProperties": false,
          "examples": [
            {
              "noIndentUnder": [
                "html",
                "body"
              ],
              "indentSize": 2
            }
          ]
        },
        "customHtmlFormatter.configWriteScope": {
          "type": "string",
          "enum": [
            "workspace",
            "global"
          ],
          "enumDescriptions": [
            "Write to this workspace's settings only",
            "Write to the global (or user)  settings - affects all workspaces"
          ],
          "default": "workspace",
          "description": "Write the rules and default formatter choice to global (user) or workspace settings."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p tsconfig.json && npm run copy:fixtures",
    "watch": "tsc -p tsconfig.json --watch",
    "lint": "eslint src",
    "copy:fixtures": "node scripts/copy-fixtures.js",
    "test": "npm run compile && npm run copy:fixtures && npm run test:unit",
    "test:unit": "mocha out/test/unit/**/*.js",
    "test:watch": "mocha --watch out/test/unit/**/*.js"
  },
  "dependencies": {
    "js-beautify": "^1.15.4",
    "parse5": "^7.1.2"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.107.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.5.2",
    "diff": "^8.0.2",
    "eslint": "^9.25.1",
    "glob": "^13.0.0",
    "typescript": "^5.8.3"
  }
}