import * as diff from "diff";

export function printLineDiff(
  expected: string,
  actual: string,
  options?: {
    normalizeLineEndings?: boolean;
    header?: string;
    showLineNumbers?: boolean;
  }
): void {
  const normalize = (text: string) =>
    options?.normalizeLineEndings === false
      ? text
      : text.replace(/\r\n/g, "\n");

  const a = normalize(expected);
  const b = normalize(actual);

  const parts = diff.diffLines(a, b);

  if (options?.header) {
    console.log(options.header);
  }

  let printed = false;
  let expectedLine = 1;
  let actualLine = 1;

  for (const part of parts) {
    const lines = part.value.split("\n");
    if (lines[lines.length - 1] === "") {
      lines.pop();
    }

    if (part.added) {
      printed = true;
      for (const line of lines) {
        const prefix = options?.showLineNumbers
          ? `+${actualLine.toString().padStart(4)} `
          : "+";
        console.log(`${prefix}:${line}`);
        actualLine++;
      }
    } else if (part.removed) {
      printed = true;
      for (const line of lines) {
        const prefix = options?.showLineNumbers
          ? `-${expectedLine.toString().padStart(4)} `
          : "-";
        console.log(`${prefix}:${line}`);
        expectedLine++;
      }
    } else {
      expectedLine += lines.length;
      actualLine += lines.length;
    }
  }

  if (!printed) {
    console.log("(no visible line diff)");
  }
}
